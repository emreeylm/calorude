          }
        }
      }
    },
    "reaction.everyday.unhinged.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mediocre meal, mediocre effort. But at least you log, which counts for something, damn it. Raise the bar a little tomorrow."
