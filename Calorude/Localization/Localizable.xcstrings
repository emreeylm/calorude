    },
    "roast.sweet.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessert beat you. Not a crime, but starting with 'just one bite' and finishing the plate is creative fiction."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatlıya yenilmişsin. Suç değil, ama 'tek lokma' diye başlayıp tabağı bitirmek bir tür kurgu yazarlığı."
