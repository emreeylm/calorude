      }
    },
    "paywall.sample.optimistic" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A single day doesn't define you. You're strong again tomorrow."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir gün seni tanımlamaz. Yarın yine güçlüsün."
          }
        }
      }
    },
    "paywall.sample.savage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You didn't pass the target, you ran it over."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedefi aşmamışsın, üzerinden geçmişsin."
          }
        }
      }
    },
    "paywall.sample.unhinged" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you hang the target on the wall as decoration, damn it?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedefi duvara tablo diye mi astın lan?"
          }
        }
      }
    },
    "paywall.sample.nuclear" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You made yourself a promise and betrayed it at the first chance."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendine söz verdin, ilk fırsatta ihanet ettin."
          }
        }
      }
    }
