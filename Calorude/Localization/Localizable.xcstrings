    "coach.meal.unbalancedWithin.unhinged.evening.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gece sana ait olacaktı, şimdi sofraya ait."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The night was supposed to be yours, now it belongs to the table."
          }
        }
      }
    },
    "coach.meal.unbalancedWithin.unhinged.evening.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güzel görünmek için çıkacaktın, sofradan çıkmak bile zor görünüyor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You were going out to look good, leaving the table already looks hard enough."
          }
        }
      }
    },
    "coach.meal.unbalancedWithin.unhinged.evening.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gecenin başrolü olacaktın, şu an tabağın yardımcı oyuncusu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You were going to be the night's lead, now you're the plate's supporting actor."
          }
        }
      }
    },
