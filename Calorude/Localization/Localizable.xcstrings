          }
        }
      }
    },
    "yourMeals" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the record"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabakta ne var?"
          }
        }
      }
    },
    "notif.breakfast.toxic.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not a word since breakfast. Are you scared of me? I don't bite, I just judge mercilessly."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahvaltıdan sonra ses vermiyorsun. Benden mi korkuyorsun? Isırmam, sadece acımasızca yargılarım."
          }
        }
      }
    },
    "notif.breakfast.toxic.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every morning you make promises and vanish at the first chance. Did today's first escape start at breakfast?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her sabah söz veriyorsun, ilk fırsatta kayboluyorsun. Bugünün ilk kaçışı kahvaltıyla mı başladı?"
          }
        }
      }
    },
    "notif.breakfast.toxic.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was breakfast eaten, or is it 'I'll check later' again? Your record is clear: that 'later' never comes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahvaltı yapıldı mı, yoksa yine 'sonra bakarım' mı? Sicilin ortada, o 'sonra' hiç gelmiyor."
          }
        }
      }
    },
    "notif.dinner.toxic.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're not mentioning dinner because you lack the nerve to finish the day. Same escape every day."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akşam yemeğinden bahsetmiyorsun çünkü günü bitirecek cesaretin yok. Her gün aynı kaçış."
          }
        }
      }
    },
    "notif.dinner.toxic.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's evening and your record is clear: you always let the last meal pass in silence. How about breaking that shameful tradition today?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akşam oldu, sicilin ortada: son öğünü hep sessiz geçiyorsun. Bugün bu rezil geleneği bozmaya ne dersin?"
          }
        }
      }
    },
    "notif.dinner.toxic.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No dinner in sight, the day isn't finished, and neither are you. Finish something for once."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akşam yemeği ortada yok, gün tamamlanmadı, sen de tamamlanmadın. Bir kere bir işi bitir."
          }
        }
      }
    },
    "notif.emptyEvening.toxic.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not a sound today. Hunger strike, or are you scared of me? Either way you wasted today. Go eat, be different tomorrow."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün tek ses çıkmadı. Açlık grevi mi, yoksa benden mi korkuyorsun? Hangisi olursa olsun bugünü çöpe attın. Git ye, yarın farklı ol."
          }
        }
      }
    },
    "notif.emptyEvening.toxic.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A whole day passed in silence. You have a goal, a plan, and no result. Eat dinner; maybe tomorrow is different."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koca bir gün sessiz geçti. Hedefin var, planın var, sonucun yok. Akşam yemeğini ye, belki yarın farklı olur."
          }
        }
      }
    },
    "notif.emptyEvening.toxic.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The day ended and you weren't there. The excuses haven't run out, they've just queued up. Go eat something."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gün bitti ve sen yoktun. Bahaneler tükenmedi, sadece sıraya girmiş. Git bir şeyler ye."
          }
        }
      }
    },
    "notif.emptyNoon.toxic.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's noon and still not a sound. Hunger strike, or are you scared of me? Either way it's a pathetic escape. Go eat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle oldu ve hâlâ tek ses yok. Açlık grevi mi, yoksa benden mi korkuyorsun? Hangisi olursa olsun aciz bir kaçış. Git ye."
          }
        }
      }
    },
    "notif.emptyNoon.toxic.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I heard nothing this morning and noon is slipping by. People who leave everything for 'later' get nowhere. Eat now."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabah hiçbir şey duymadım, öğle de geçiyor. Her şeyi 'sonra'ya bırakan hiçbir yere varmaz. Şimdi ye."
          }
        }
      }
    },
    "notif.emptyNoon.toxic.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silence all morning. Hiding, not eating or forgetting; all three describe you. Go eat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bütün sabah ses yok. Ya saklanıyorsun ya yemiyorsun ya unutuyorsun. Üçü de seni tarif ediyor. Git ye."
          }
        }
      }
    },
    "notif.lunch.toxic.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No word on lunch because you're either lazy or scared of me. Both suit you."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle yemeğinden haber yok çünkü ya tembelsin ya da benden korkuyorsun. İkisi de sana yakışıyor."
          }
        }
      }
    },
    "notif.lunch.toxic.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every noon the same: eat, flee, vanish quietly. Try something different today, I haven't gotten used to it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her öğle aynı: yersin, kaçarsın, sessizce kaybolursun. Bugün farklı bir şey dene, ben alışamadım."
          }
        }
      }
    },
    "notif.lunch.toxic.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunch has passed and you're still nowhere to be seen. The road to your goal is moving just as quietly."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle geçti ve sen hâlâ ortalıkta yoksun. Hedefine giden yol da bu kadar sessiz ilerliyor."
          }
        }
      }
    },
    "intensity.toxic" : {
      "extractionState" : "manual",
      "localizations" : {
