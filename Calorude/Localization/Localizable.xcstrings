    "reaction.everyday.unhinged.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal, {protein} g protein. No star, no disaster, just a whole lot of 'meh', damn it. I wondered if something this mediocre deserved a log, but you did it, fine."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal, {protein} g protein. Ne yıldız ne felaket, tam bir 'öylesine' lan. Bu kadar vasat bir tabağa kayıt tutulur mu diye düşündüm ama tuttun, tamam."
          }
