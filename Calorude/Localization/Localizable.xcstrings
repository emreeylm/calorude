    "coach.meal.unbalancedWithin.unhinged.lowProtein.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteini çağırmayı mı unuttun, gelmesin diye özellikle mi uğraştın?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you forget to call the protein, or did you work hard to keep it away?"
          }
        }
      }
    },
    "coach.meal.unbalancedWithin.unhinged.lowProtein.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteini ihmal etmek sende alışkanlık olmuş."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neglecting protein has become your habit."
          }
        }
      }
    },
    "coach.meal.unbalancedWithin.unhinged.lowProtein.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protein mi? Bu tabaktan haberi bile yok."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protein? It doesn't even know about this plate."
          }
        }
