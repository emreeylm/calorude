    "roast.sweet.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sweet craving is on record. Sugar deserves a story, but let's not make it the end of every meal."
