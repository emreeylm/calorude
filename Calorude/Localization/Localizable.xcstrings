          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunchtime and I still haven't heard a thing. A wrap, a salad, or just good intentions?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle yemeği vakti ve ben hâlâ haber alamadım. Dürüm mü, salata mı, yoksa sadece iyi niyet mi?"
          }
        }
      }
    },
    "notif.lunch.normal.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lunch break is coming and going. Your stomach may be full, my curiosity isn't."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle arası gelip geçiyor. Karnın doydu mu bilmiyorum, merakım doymadı."
          }
        }
      }
    },
    "notif.lunch.optimistic.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunch energy time! Have a good meal and fuel the second half of the day!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle enerjisi zamanı! Güzel bir yemek yiyip günün ikinci yarısına gaz ver!"
          }
        }
      }
    },
    "notif.lunch.optimistic.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deserve a good lunch. Take care of yourself, your day is going great."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güzel bir öğle yemeği hak ediyorsun. Kendine iyi bak, günün harika gidiyor."
          }
        }
      }
    },
    "notif.lunch.optimistic.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's noon and you're in form! Enjoy your meal and we'll meet the evening together."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle oldu, formdasın! Yemeğini keyifle ye, akşamı birlikte karşılayalım."
          }
        }
      }
    },
    "notif.lunch.savage.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunch has come and gone. I don't know what you ate and you seem to have forgotten too."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle geçti. Ne yediğini bilmiyorum, sen de unutmuşa benziyorsun."
          }
        }
      }
    },
    "notif.lunch.savage.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I don't like lunch being brushed past in silence. Whatever's on that plate, there's nothing to hide."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğleyi sessizce geçiştirmek hoşuma gitmiyor. Tabaktaki ne olursa olsun gizlenecek bir şey yok."
          }
        }
      }
    },
    "notif.lunch.savage.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has lunch become a secret? This much mystery shows you're on the defensive."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle yemeği bir sır mı oldu? Bu kadar gizem, savunmaya geçtiğini gösteriyor."
          }
        }
      }
    },
    "notif.lunch.unhinged.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where's your lunch? Either you ate and went quiet or you skipped and you're proud. Both are embarrassing."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle yemeğin nerede? Ya yedin ve sustun ya yemedin ve gururlanıyorsun. İkisi de rezil."
          }
        }
      }
    },
    "notif.lunch.unhinged.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's noon and I hear nothing from you. If you try to remember tonight and just make things up, I'll know."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat öğle, senden ses yok. Akşam hatırlamaya çalışıp uydurursan hemen anlarım."
          }
        }
      }
    },
    "notif.lunch.unhinged.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've joined the caravan of noon silence. I wonder how long this embarrassment will last."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğle sessizliği kervanına katıldın. Bu rezillik nereye kadar sürecek merak ediyorum."
          }
        }
      }
    },
    "notification.evening.pro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coach is waiting for the report. Check your meals and protein; have a proper meal if you still need one."
