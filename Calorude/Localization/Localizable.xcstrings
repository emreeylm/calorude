        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedefin {target} kcal, gösterdiğin çaba sıfır. Matematikte buna 'başlamamış' diyoruz."
          }
        }
      }
    },
    "roast.fast.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You met fast food today. No problem, but we know fries are a side, not the main event."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün fast foodla tanıştın. Sorun yok ama patatesin 'yanında' geldiğini biliyoruz, ana yemek olmadığını da."
          }
        }
      }
    },
    "roast.fast.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You ate fast food, fine. The problem would be presenting it as 'portion control'."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast food yemişsin, sorun değil. Sorun, bunu 'porsiyon kontrolü' diye sunman olurdu."
          }
        }
      }
    },
    "roast.fast.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't sell that combo box as a 'reward', damn it. It's not a prize, it's a record: {kcal} kcal so far today. If the next meal has no greens, we're not speaking."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutudan çıkan menüyü 'ödül' diye satma lan. Bu ödül değil, kayıt: bugüne {kcal} kcal. Sonraki öğünde yeşillik yoksa küseriz."
          }
        }
      }
    },
    "roast.fast.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The combo box got you today. Give yourself permission to cross to the vegetable side tomorrow."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutudaki menü bugün seni yakalamış. Yarın sebze tarafına geçmek için kendine izin ver."
          }
        }
      }
    },
    "roast.fast.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauce, fries, cola... you completed the trio flawlessly. Show the same energy to vegetables at the next meal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sos, patates, kola... Üçlüyü eksiksiz tamamlamışsın. Bir sonraki öğünde bu enerjiyi sebzeye göster."
          }
        }
      }
    },
    "roast.fast.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You got the full set, damn it: fast food, cola and a side of guilt. Drop the guilt and focus on a balanced next meal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast food, kola, bir de vicdan azabı seti almışsın lan. Vicdanı bırak, dengeli bir sonraki öğüne odaklan."
          }
        }
      }
    },
    "roast.fast.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fast food incident is logged; the jury rules tomorrow. For now, at least drink some water."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast food olayı kaydedildi, jüri kararını yarın verecek. Şimdilik en azından su iç."
          }
        }
      }
    },
    "roast.fast.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast food receipt in hand, defense at zero. I want to see something green on the next plate."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast food fişi elinde, savunman sıfır. Sonraki öğünde tabakta yeşil bir şey görmek istiyorum."
          }
        }
      }
    },
    "roast.high.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target exceeded by {over} kcal. Tomorrow, normal plan; today's presentation can be titled 'Excuses and Side Effects'."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef aşıldı: {over} kcal fazla. Yarın normal plan; bugünkü sunumun adını 'Bahaneler ve Yan Etkileri' koyabiliriz."
          }
        }
      }
    },
    "roast.high.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target blown by {over} kcal. Close the excuse deck; tomorrow, back to your normal plan, no starving."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef {over} kcal aşıldı. Bahane sunumunu kapat; yarın aç kalmadan normal planına dön."
          }
        }
      }
    },
    "roast.high.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did you hang the target on the wall as decoration, damn it? {kcal} kcal, {over} over. The numbers aren't buying your story. Tomorrow, don't starve, just eat like an adult."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedefi duvara tablo diye mi astın lan? {kcal} kcal, {over} kcal fazla. Rakamlar masalını yemiyor. Yarın aç kalma, sadece adam gibi ye."
          }
        }
      }
    },
    "roast.high.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The log says {kcal} kcal. The target waved at you but you drove right past."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt {kcal} kcal diyor. Hedef sana el salladı ama sen arabayla geçip gittin."
          }
        }
      }
    },
    "roast.high.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal. Do you think ignoring the target makes it disappear? The numbers don't lie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal. Hedefi görmezden gelirsen yok olacağını mı sanıyorsun? Rakamlar yalan söylemiyor."
          }
        }
      }
    },
    "roast.high.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{over} kcal over. That's not dinner, that's you drafting a legal defense, damn it. Judge Numbers has ruled: back to routine tomorrow."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{over} kcal fazla. Bu akşam yemeği değil lan, savunma dilekçesi yazıyorsun. Yargıç Rakamlar kararını verdi: yarın düzene dön."
          }
        }
      }
    },
    "roast.high.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You went {over} kcal over. Luckily tomorrow comes with a new day and a new plate."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{over} kcal fazlaya girdin. Neyse ki yarın yeni bir gün ve yeni bir tabakla geliyor."
          }
        }
      }
    },
    "roast.high.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're {over} kcal over with a 'so what' attitude. What happened: the plan resigned today."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{over} kcal fazlan var ve tavrın 'ne olmuş yani'. Olan şu: plan bugün istifa etti."
          }
        }
      }
    },
    "roast.low.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's evening and you're at {kcal} kcal. The tank is empty and you're still posing as 'I never get hungry'. Eat a proper meal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akşam oldu ve {kcal} kcal'desin. Depo boş, sen hâlâ 'ben hiç acıkmam' pozundasın. Düzgün bir öğün ye."
          }
        }
      }
    },
    "roast.low.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eating too little isn't an achievement, it's neglect. You're {left} kcal short; sit down and make a real meal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az yemek başarı değil, ihmaldir. {left} kcal eksiğin var; oturup düzgün bir öğün hazırla."
          }
        }
      }
    },
    "roast.low.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the hell is this, a meal plan or a dead remote? Don't play hero on {kcal} kcal. Get up and eat a proper meal with protein and carbs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lan, bu beslenme planı mı yoksa şarjı bitmiş kumanda mı? {kcal} kcal ile kahramanlık taslama. Kalk, protein ve karbonhidratlı düzgün bir yemek ye."
          }
        }
      }
    },
    "roast.low.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're trying to close the day at {kcal} kcal. You'd never let your phone battery drop this low. Eat a proper meal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günü {kcal} kcal ile kapatmaya çalışıyorsun. Telefonunun bile şarjı bu kadar düşmesine izin vermiyorsun, düzgün bir yemek ye."
          }
        }
      }
    },
    "roast.low.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You met the evening on half a day's energy and you're proud of it. Go eat; pride can wait."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yarım günlük enerjiyle akşamı karşılamışsın ve bununla gurur duyuyorsun. Git ye, gururu sonra yersin."
          }
        }
      }
    },
    "roast.low.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your target is {target} kcal and you're at {kcal}. Starving doesn't take you anywhere, damn it, except tomorrow's kitchen meltdown. Get up and eat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedefin {target} kcal, sen {kcal} kcal'desin. Aç kalmak seni hiçbir yere götürmez lan, en fazla yarınki mutfak krizine. Kalk ve ye."
          }
        }
      }
    },
    "roast.low.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target {target}, you're at {kcal}. That's not a diet, that's a lost-and-found notice for dinner. Sit at the table."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef {target}, sen {kcal}. Bu diyet değil, akşam yemeği için verilmiş bir kayıp ilanı. Sofraya otur."
          }
        }
      }
    },
    "roast.low.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can't run a marathon on {kcal} kcal. Your body is taking notes on this stubbornness; go plate something."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal ile maraton koşulmaz. Bedenin bu inadı not alıyor, git bir tabak hazırla."
          }
        }
      }
    },
    "roast.perfect.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal}/{target} kcal with protein on target. Not a coincidence, though whether you can keep it going is another question."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal}/{target} kcal ve protein hedefte. Bu tesadüf değil, ama sürdürebilecek misin, o ayrı konu."
          }
        }
      }
    },
    "roast.perfect.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target hit. One good day is easy; the real question is doing it again tomorrow."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef tutmuş. Bir gün doğru yapmak kolay, asıl mesele yarın da aynısını yapabilmen."
          }
        }
      }
    },
    "roast.perfect.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damn, {kcal} kcal and {protein} g protein, right on target. We saw you can do it, so why do you run an excuse factory the rest of the week?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
