    },
    "roast.earlyHigh.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal and it's not evening yet. That's not appetite, that's a declaration of war on your target. Build dinner around veg and protein and drop the drama."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal, saat daha akşam değil. Bu iştah değil lan, hedefe açılmış bir savaş. Akşam yemeğini sebze ve proteinle dengeli kur, dramayı bırak."
          }
