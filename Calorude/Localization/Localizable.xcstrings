      }
    },
    "roast.sweet.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to the caravan of people who say 'one slice' and finish the tray, damn it. Dessert logged. Tomorrow, show your alleged willpower honestly."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lan, 'tek dilim' deyip tepsiyi bitirenler kervanına hoş geldin. Tatlı kaydı tamam. Yarın sözde irade gücünü dürüstçe göster."
          }
        }
      }
    },
    "roast.sweet.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dessert cabinet caught you. A protein and fiber meal next will pull you back together."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatlı dolabı seni yakalamış. Sonraki öğünde protein ve lifle kendini toparlarsın."
          }
        }
      }
    },
    "roast.sweet.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugar called and you couldn't say no. Spend that willpower on vegetables at the next meal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şeker seni çağırdığında 'hayır' diyemedin. Sonraki öğünde bu iradeyi sebzeye harca."
          }
        }
      }
    },
    "roast.sweet.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Did dessert do something to you, damn it? You ate it like it was revenge. You logged it, good. Make the next meal protein-based."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatlı sana bir şey mi yaptı da intikam alır gibi yiyorsun lan? Kaydı tuttun, iyi. Sonraki öğün proteinli olsun."
          }
        }
      }
    },
    "roast.sweet.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One piece of dessert may have turned into two. I'm not saying anything; the log speaks."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir parça tatlı iki parçaya dönüşmüş olabilir. Ben bir şey demiyorum, kayıt konuşuyor."
          }
        }
      }
    },
    "roast.sweet.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessert logged, no defense. If the same craving hits at the same time tomorrow, it's not a craving anymore, it's a habit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatlı kaydı geldi, savunma yok. Yarın aynı saatte aynı krizle karşılaşırsan bu artık kriz değil, alışkanlık."
          }
        }
      }
    },
    "roast.veryHigh.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal! The target was {target}; you treated 'target' as suggested reading. Tomorrow is a new page."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal! Hedef {target} kcal'di, sen 'hedef'i önerilen okuma sanmışsın. Yarın yeni sayfa."
          }
        }
      }
    },
    "roast.veryHigh.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You didn't pass the target, you ran it over. {over} kcal extra. Skip the excuses; back to your normal plan tomorrow."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedefi aşmamışsın, üzerinden geçmişsin. {over} kcal fazla. Bahane üretme; yarın normal planına dön."
          }
        }
      }
    },
    "roast.veryHigh.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The damn target is right there and you're doing victory laps at the buffet. {kcal} kcal, {over} over. You wrecked today's plan. No starvation stunt tomorrow; return to your routine."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lan hedef orada duruyor, sen açık büfede zafer turu atıyorsun. {kcal} kcal, {over} kcal fazla. Bugünkü planı darmadağın ettin. Yarın açlık şovu yok; düzene dön."
          }
        }
      }
    },
    "roast.veryHigh.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record broken: {over} kcal over. The kitchen gives you a standing ovation while the plan is buried in the couch. Stay calm tomorrow."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekor kırdın: hedefin {over} kcal üstü. Mutfak seni ayakta alkışlıyor, plan ise koltuğa gömülmüş. Yarın sakin devam."
          }
        }
      }
    },
    "roast.veryHigh.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal. You fought the buffet and the buffet won. Rematch tomorrow, without starving."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal. Açık büfeyle savaşmışsın ve büfe kazanmış. Rövanş yarın, aç kalmadan."
          }
        }
      }
    },
    "roast.veryHigh.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{over} kcal over, did you win a contest at that table, damn it? Your prize is this number. Tomorrow: normal meals, no compensation starving, just brains."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{over} kcal fazla, yoksa o sofrada yarışma mı kazandın lan? Ödülün bu rakam. Yarın normal öğünler, telafi açlığı yok, sadece akıl."
          }
        }
      }
    },
    "roast.veryHigh.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calling this a meal is generous; it was a festival. {over} kcal over needs a normal day tomorrow, not a compensation show."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buna öğün demek cömertlik olur, festivaldi. {over} kcal fazlası için yarın normal düzen yeter, telafi şovu şart değil."
          }
        }
      }
    },
    "roast.veryHigh.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's total isn't a food log, it's a confession. Writing down {over} extra kcal was honest, and that's all it was."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünkü toplam bir yemek günlüğü değil, itiraf metni. {over} kcal fazlasını yazarak dürüst davrandın, o kadar."
          }
        }
      }
    },
    "roast.week.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The weekly picture is together: near target on {weekDays} of 7 days. No big speeches, same routine."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haftalık tablo toparlanmış: 7 günün {weekDays} tanesinde hedefe yakınsın. Büyük konuşma yok, aynı düzen."
          }
        }
      }
    },
    "roast.week.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{weekDays} of 7 days on target. You've shown it wasn't just Monday enthusiasm. Continue."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 günün {weekDays} tanesi hedefte. Sadece pazartesi hevesi olmadığını göstermişsin. Devam."
          }
        }
      }
    },
    "roast.week.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Well damn, the motivational speech actually got a sequel: on target {weekDays} of 7 days. This week your work talked, not your excuses. Keep it up."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vay lan, motivasyon nutkunun devamı gelmiş: 7 günün {weekDays} tanesi hedefte. Bu hafta bahanelerin değil işin konuştu. Böyle devam."
          }
        }
      }
    },
    "roast.week.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This week: {weekDays}/7. Turns out you're not a Monday-enthusiasm type. Nice surprise."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hafta {weekDays}/7. Pazartesi hevesiyle uğraştığım biri değilmişsin, güzel sürpriz."
          }
        }
      }
    },
    "roast.week.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Week {weekDays}/7. Don't prep excuses for the remaining days; sit on target."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hafta {weekDays}/7. Kalan günler için mazeret hazırlama, hedefe otur."
          }
        }
      }
    },
    "roast.week.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{weekDays}/7. You're not fooling yourself, sure, but if you treat the weekend as a rule-free 'reward', I'll notice, damn it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{weekDays}/7. Kendini kandırmıyorsun, tamam, ama hafta sonunu 'ödül' diye kuralsız sanırsan fark ederim lan."
          }
        }
      }
    },
    "roast.week.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On target {weekDays} days this week. I'm already ready to hear excuses for the remaining ones."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haftada {weekDays} gün hedefte. Kalan günlerin bahanelerini şimdiden dinlemeye hazırım."
          }
        }
      }
    },
    "roast.week.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{weekDays} good days, that's decent. But I've got my eye on any 'I deserve it' rescue attempt at the weekend."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{weekDays} gün doğru, bu iyi. Ama hafta sonunu 'hak ettim' diye kurtarma girişimlerine karşı gözüm üzerinde."
          }
        }
      }
    },
    "roast.weight.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scale moved: your weekly average shifted {trend} kg. Don't write an epic from one number; the trend is what counts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartı hareket etmiş: haftalık ortalaman {trend} kg oynamış. Tek sayıyla destan yazma; bakılacak şey trend."
          }
        }
      }
    },
    "roast.weight.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't make big decisions from one weigh-in. The weekly average shifted {trend} kg; talk based on that."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir tartı sonucundan büyük karar çıkarma. Haftalık ortalama {trend} kg oynamış; ona göre konuş."
          }
        }
      }
    },
    "roast.weight.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scale showed a number and you wrote a TV drama, damn it. Kill the drama; measure under the same conditions and look at the weekly trend."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartı bir sayı gösterdi, sen dizi senaryosu yazdın lan. Dramayı kapat; aynı koşullarda ölç, haftalık trende bak."
          }
        }
      }
    },
    "roast.weight.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The average changed by {trend} kg. That's neither doomsday nor victory news, just data."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortalama {trend} kg değişti. Bu ne kıyamet ne zafer haberi, sadece veri."
          }
        }
      }
    },
    "roast.weight.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't fight the scale and forget logic. Same time, same conditions, weekly average: those are the rules."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartıyla kavga edip mantığı unutma. Aynı saat, aynı koşul, haftalık ortalama: kural bu."
          }
        }
      }
    },
    "roast.weight.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The average shifted {trend} kg and you went into crisis mode instantly, damn it. Decide with a week of data, not with panic."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortalama {trend} kg oynamış ve sen hemen kriz moduna girdin lan. Bir haftalık veriyle karar ver, panikle değil."
          }
        }
      }
    },
    "roast.weight.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scale said something and you commented right away. Judging by one reading is like reviewing an album from one song."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartı bir şey söyledi, sen de hemen yorum yaptın. Tek ölçümle karar vermek, tek şarkıyla albüm eleştirmek gibi."
          }
        }
      }
    },
    "roast.weight.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A {trend} kg shift can come from daily water and salt swings. Watch two weeks without panicking."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{trend} kg oynama günlük su ve tuz dalgalanmasından bile olabilir. Panik yapmadan iki hafta izle."
          }
        }
      }
    },
