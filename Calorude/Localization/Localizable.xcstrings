    "validation.eligibility" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmation is required to continue. This plan isn't suitable during pregnancy, breastfeeding or eating disorder treatment; please see a professional."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam etmek için onay gerekiyor. Bu plan hamilelik, emzirme ya da yeme bozukluğu tedavisi sırasında uygun değildir; bir uzmana danış."
          }
        }
      }
    },
    "validation.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a name or nickname."
          }
