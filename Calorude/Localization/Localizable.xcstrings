    },
    "reaction.everyday.unhinged.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What can I say about this meal, damn it, a reactionless plate. If it were a movie it'd get neither praise nor scorn; it'd be forgotten. Be bolder next time."
          }
