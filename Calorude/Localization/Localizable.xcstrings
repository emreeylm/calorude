    "notification.policy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At most three reminders a day: breakfast (9:30 AM), lunch (1:30 PM) and dinner (8 PM). Messages are in your coach mode's voice, and a meal you've already logged sends nothing. Change notification permission in iOS Settings."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde en fazla üç hatırlatma: kahvaltı (09:30), öğle (13:30) ve akşam (20:00). Mesajlar seçtiğin koç moduyla gelir; öğünü girdiysen o saatte bildirim gitmez. Bildirim iznini iOS Ayarları'ndan değiştirebilirsin."
          }
        }
      }
    },
