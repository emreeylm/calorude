    },
    "roast.earlyHigh.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's not even evening and you're {over} kcal over, damn it. Check on the target before it files a missing-person report. Zero drama tonight, and don't starve tomorrow either; just eat like an adult."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lan saat daha akşam olmadı, {over} kcal fazlaya girmişsin. Hedef kayıp ilanı vermeden bir bak bakalım. Akşama sıfır drama, yarın da aç kalma; sadece adam gibi ye."
          }
        }
      }
    },
    "roast.earlyHigh.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The log says {kcal} kcal and it's still early. Someone who burns the whole budget by noon must love payday."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal yazıyor ve saat hâlâ erken. Günün ilk yarısında bütçeyi bitiren biri, maaş gününü çok seviyor olmalı."
          }
        }
      }
    },
    "roast.earlyHigh.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{kcal} kcal and it's not even evening. You're not looking at the target, you're just waving as you pass it."
