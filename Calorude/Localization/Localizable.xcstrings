    "validation.profile" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your details. Add a name and an appropriate target, and confirm adult eligibility. A loss target must be lower than your current weight; a gain target must be higher."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgileri kontrol et. Bir isim, uygun bir hedef ve yetişkin kullanım koşulları gerekiyor. Kilo verme hedefi mevcut kilondan düşük, kilo alma hedefi yüksek olmalı."
          }
        }
      }
    },
