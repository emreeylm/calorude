      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışarı çıkacaksan bu tabak seni geç bırakır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you're going out, this plate will make you late."
          }
        }
      }
    },
    "coach.meal.unbalancedWithin.savage.evening.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akşam planı yapmıştın, ikinci tabak plana girmemişti."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You made evening plans, the second plate wasn't in them."
          }
        }
      }
    },
    "coach.meal.unbalancedWithin.savage.evening.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu saatte bu tabak seni kapıya değil mutfağa bağlıyor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At this hour this plate ties you to the kitchen, not the door."
          }
        }
      }
    },
    "coach.meal.unbalancedWithin.savage.evening.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gece daha başlamadı, sen sofradan kalkamıyorsun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The night hasn't started and you can't leave the table."
          }
        }
      }
    },
