    },
    "roast.steady.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All is well, boring and beautiful. The secret of a healthy routine is being boring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şey yolunda, sıkıcı ve güzel. Sağlıklı düzenin sırrı zaten sıkıcılık."
