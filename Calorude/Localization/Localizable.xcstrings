    "coach.meal.unbalancedWithin.savage.lowProtein.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protein nerede bro, proteinle küstün mü?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where's the protein, bro? Are you two fighting?"
          }
        }
      }
    },
    "coach.meal.unbalancedWithin.savage.lowProtein.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protein listede yok, tabakta da yok."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protein's not on the list or on the plate."
          }
        }
      }
    },
    "coach.meal.unbalancedWithin.savage.lowProtein.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kadar yemek, bu kadar az protein. Matematik tuhaf."
