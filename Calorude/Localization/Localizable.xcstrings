    "roast.streak.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Well damn, {streak} days! The excuses are finally unemployed. This streak came from work, not talk. Don't relax now and trash it all."
