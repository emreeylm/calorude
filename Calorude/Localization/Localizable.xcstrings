        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir isim ya da lakap yaz."
          }
        }
      }
    },
    "validation.profile" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your details. Add a name and an appropriate target, and confirm adult eligibility. A loss target must be lower than your current weight; a gain target must be higher."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgileri kontrol et. Bir isim, uygun bir hedef ve yetişkin kullanım koşulları gerekiyor. Kilo verme hedefi mevcut kilondan düşük, kilo alma hedefi yüksek olmalı."
          }
        }
      }
    },
    "validation.target.bmi" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This target is below the healthy range (BMI 18.5). Pick a higher target."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hedef sağlıklı sınırın altında (BMI 18,5). Daha yüksek bir hedef seç."
          }
        }
      }
    },
    "validation.target.bmi.high" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This target is too high (BMI above 30). Pick a more moderate one."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hedef çok yüksek (BMI 30 üzeri). Daha ılımlı bir hedef seç."
          }
        }
      }
    },
    "validation.target.gain" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target weight must be higher than your current weight."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef kilo şu anki kilondan yüksek olmalı."
          }
        }
      }
    },
