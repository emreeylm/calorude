    },
    "roast.earlyHigh.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target {target} kcal, you're already at {kcal}. That wasn't a lunch break, that was a record attempt."
