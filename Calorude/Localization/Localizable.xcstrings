    },
    "reaction.snackHeavy.savage.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protein {protein} g, packaging trash aplenty. The quality of this meal is a warning sign."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protein {protein} g, ambalaj çöpü ise bol. Bu öğünün kalitesi tam bir uyarı işareti."
          }
        }
      }
    },
    "reaction.snackHeavy.savage.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filling up on snacks and saying 'I had a meal' is like riding a minibus and saying 'I flew here'."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atıştırmalıkla doyup 'öğün yedim' demek, dolmuşa binip 'uçakla geldim' demek gibi."
          }
        }
      }
    },
    "reaction.snackHeavy.unhinged.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You call this a plate, damn it? {kcal} kcal and just {protein} g protein. Opening a packet isn't cooking! This meal's management is a total fiasco. A real meal next time, deal?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buna tabak mı diyorsun lan? {kcal} kcal ve sadece {protein} g protein. Paket açmak yemek yapmak değil! Bu öğünün yönetimi tam bir fiyasko. Bir dahaki sefere gerçek yemek, anlaştık mı?"
          }
        }
      }
    },
    "reaction.snackHeavy.unhinged.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A plate like a packaging graveyard: {kcal} kcal and {protein} g protein. Your body doesn't accept this as 'food', damn it. Fix it at the next meal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambalaj mezarlığı gibi bir tabak: {kcal} kcal ve {protein} g protein. Bedenin bunu 'yemek' olarak kabul etmiyor lan, sonraki öğünde düzelt."
          }
        }
      }
    },
    "reaction.snackHeavy.unhinged.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even the fridge is embarrassed by this plate, damn it. {kcal} kcal of snacks, {protein} g protein. Don't starve, but cook next time; opening a packet isn't cooking."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tabağı görünce buzdolabı bile utandı lan. {kcal} kcal atıştırmalık, {protein} g protein. Aç kalma ama bir dahaki sefere yemek yap; paket açmak yemek pişirmek değildir."
          }
        }
      }
    },
