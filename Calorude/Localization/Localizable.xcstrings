    "roast.earlyHigh.8" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{over} kcal over but it's still early; balance tonight and the day is saveable. You've got this."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{over} kcal fazla ama saat daha erken; akşamı dengeli kurarsan gün hâlâ kurtarılabilir. Sen bu işi bilirsin."
          }
        }
      }
    },
    "roast.earlyHigh.9" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A little early overshoot, life happens. Pick a balanced, protein-rich dinner and the day is still yours."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkenden biraz taşmışsın, hayat bu. Akşam yemeğini dengeli ve proteinli seç, gün yine senin."
          }
        }
      }
    },
    "roast.earlyHigh.10" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You passed the target early but you're still logging, and that's the real heroism. Carry on tonight with a smile."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedefi erkenden geçtin ama kayıt tutmaya devam ediyorsun, işte gerçek kahramanlık bu. Akşama gülümseyerek devam."
          }
        }
      }
    },
    "roast.empty.8" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clean slate, fresh start. The moment you log your first meal, you're the hero of the day."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temiz sayfa, sıfırdan başlama fırsatı. İlk öğünü kaydettiğin an günün kahramanı sensin."
          }
        }
      }
    },
    "roast.empty.9" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The screen is empty, but it's an invitation, not a flaw. Log the first bite and the rest follows."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran boş ama bu bir kusur değil, bir davet. İlk lokmayı yaz, gerisi kendiliğinden gelir."
          }
        }
      }
    },
    "roast.empty.10" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No entries yet, so today is still flawless. Add the first meal before anything gets ruined and we'll applaud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün henüz kayıt yok, yani bugün hâlâ kusursuz. Bozulmadan ilk öğünü ekle, biz de alkışlayalım."
          }
        }
      }
    },
    "roast.low.8" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've run light today, but dinner is still in your hands. Plate something nice and we'll rescue the day."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün hafif kalmışsın ama akşam yemeği hâlâ elinde. Güzel bir tabak hazırla, günü toparlarız."
          }
        }
      }
    },
    "roast.low.9" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The {left} kcal gap isn't a problem, it's an opportunity: a tasty, filling dinner. To the kitchen!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{left} kcal'lik boşluk bir sorun değil, fırsat: lezzetli ve doyurucu bir akşam yemeği. Hadi mutfağa!"
          }
        }
      }
    },
    "roast.low.10" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your body wants fuel and you can be the one who provides. Have a good dinner and wake up energized."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedenin yakıt istiyor ve onu besleyen sen olabilirsin. Güzel bir akşam yemeği ye, yarına enerjik uyan."
          }
        }
      }
    },
    "roast.high.8" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
