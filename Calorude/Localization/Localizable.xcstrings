    "roast.steady.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything looks fine, which worries me, damn it. Usually a 'small indulgence' comes next. Keep logging; I'm watching."
