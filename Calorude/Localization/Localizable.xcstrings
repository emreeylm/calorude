    "roast.earlyHigh.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're {over} kcal over and the day isn't done. What's the plan for tonight, a second day?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gün bitmeden {over} kcal fazlasın. Akşama ne planladın, ikinci bir gün mü?"
