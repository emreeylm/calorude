    },
    "roast.empty.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The screen is empty. Either you ate nothing or you filed logging under 'later'. Tell me which before I hire a detective."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran bomboş. Ya hiçbir şey yemedin ya da kayıt işini 'sonraya' bıraktın. Dedektif tutmadan hangisi olduğunu söyler misin?"
          }
        }
      }
    },
    "roast.empty.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A blank page isn't progress. If you ate, log it; if you didn't, go eat. I can't fill the gap for you."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş sayfa ilerleme sayılmaz. Yediysen yaz, yemediysen git ye. Aradaki boşluğu ben dolduramam."
          }
        }
      }
    },
    "roast.empty.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm a coach, not a damn psychic. What am I supposed to read here, coffee grounds? If you ate, log it; if you didn't, go eat. The silent movie ends here."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lan ben koçum, falcı değilim. Bomboş ekrana ne yorum yapayım, kahve telvesine mi bakayım? Yediysen kaydet, yemediysen git ye; sessiz film burada biter."
          }
        }
      }
    },
    "roast.empty.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empty log, full of claims. The fridge named you as a witness, so get ready to testify."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş günlük, dolu iddialar. Buzdolabı seni tanık gösteriyor, ifade vermeye hazır ol."
          }
        }
      }
    },
    "roast.empty.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No log, no data, no comment. But don't worry, plans made on an empty stomach all blow up eventually."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt yok, veri yok, yorum yok. Ama merak etme, aç karnına yapılan planların hepsi bir şekilde patlıyor."
          }
        }
      }
    },
    "roast.empty.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero entries. Do you have a secret deal with the fridge, or are your fingers just on strike? {target} kcal is waiting and you're keeping it waiting."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıfır kayıt. Buzdolabıyla gizli anlaşman mı var, yoksa parmakların greve mi çıktı? {target} kcal hedefin bekliyor, sen de bekletiyorsun."
          }
        }
      }
    },
    "roast.empty.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We reserved {target} kcal for today and nobody has shown up. As the host, I'm a little embarrassed."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün için {target} kcal'lik bir yer ayırmıştık, hâlâ kimse gelmedi. Ev sahibi olarak biraz mahcubum."
          }
        }
      }
    },
    "roast.empty.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
