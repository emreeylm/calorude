    "coach.meal.unbalancedWithin.toxic.evening.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gece bütün gözler üstünde olsun diyorsun. Sen büfeden gözünü alamıyorsun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You want every eye on you tonight. You can't take yours off the snack bar."
          }
        }
      }
    },
    "coach.meal.unbalancedWithin.toxic.evening.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu gece herkes seni konuşsun diyordun, konuşulan şey tabağın oldu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You wanted everyone talking about you tonight, but they're talking about the plate."
          }
        }
      }
    },
    "coach.meal.unbalancedWithin.toxic.evening.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gece kulübü kapıda bekliyor, sen mutfakta nöbet tutuyorsun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The club is waiting at the door and you're on kitchen duty."
          }
        }
      }
    },
