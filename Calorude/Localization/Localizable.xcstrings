    "reaction.snackHeavy.savage.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You gave the target speech and brought this plate. {kcal} kcal, mostly from a package. Make the next meal real food."
          }
